using System;
using System.Security.Cryptography;
using Org.BouncyCastle.Crypto.Parameters;
using Org.BouncyCastle.Crypto.Signers;
using Org.BouncyCastle.Security;

namespace Erebos.SystemIdentity.Crypto;

public sealed record GeneratedIdentityKeyPair(
    byte[] PublicKey,
    byte[] PrivateKey)
{
    public string Algorithm { get; init; } = IdentityKeyGenerator.Algorithm;
}

public static class IdentityKeyGenerator
{
    public string Algorithm { get; init; } = IdentityKeyGenerator.Algorithm;

        public const int PublicKeySize = 32;
    public const int PrivateKeySize = 32;
    public const int SignatureSize = 64;
    public const string Algorithm = "Ed25519";
public static GeneratedIdentityKeyPair Generate()
    {
        var random = new SecureRandom();

        var privateKey = new byte[PrivateKeySize];
        random.NextBytes(privateKey);

        var privateParameters =
            new Ed25519PrivateKeyParameters(privateKey, 0);

        var publicKey =
            privateParameters.GeneratePublicKey().GetEncoded();

        if (publicKey.Length != PublicKeySize)
        {
            throw new CryptographicException(
                $"Unexpected Ed25519 public key length: {publicKey.Length}");
        }

        return new GeneratedIdentityKeyPair(
            PublicKey: publicKey,
            PrivateKey: privateKey);
    }

    public static byte[] Sign(
        ReadOnlySpan<byte> data,
        ReadOnlySpan<byte> privateKey)
    {
        if (privateKey.Length != PrivateKeySize)
        {
            throw new ArgumentException(
                $"Ed25519 private key must be {PrivateKeySize} bytes.",
                nameof(privateKey));
        }

        var keyBytes = privateKey.ToArray();
        var message = data.ToArray();

        try
        {
            var signer = new Ed25519Signer();

            signer.Init(
                true,
                new Ed25519PrivateKeyParameters(keyBytes, 0));

            signer.BlockUpdate(
                message,
                0,
                message.Length);

            var signature = signer.GenerateSignature();

            if (signature.Length != SignatureSize)
            {
                throw new CryptographicException(
                    $"Unexpected Ed25519 signature length: {signature.Length}");
            }

            return signature;
        }
        finally
        {
            CryptographicOperations.ZeroMemory(keyBytes);
            CryptographicOperations.ZeroMemory(message);
        }
    }

    public static bool Verify(
        ReadOnlySpan<byte> data,
        ReadOnlySpan<byte> signature,
        ReadOnlySpan<byte> publicKey)
    {
        if (publicKey.Length != PublicKeySize)
        {
            throw new ArgumentException(
                $"Ed25519 public key must be {PublicKeySize} bytes.",
                nameof(publicKey));
        }

        if (signature.Length != SignatureSize)
        {
            return false;
        }

        var publicKeyBytes = publicKey.ToArray();
        var message = data.ToArray();
        var signatureBytes = signature.ToArray();

        try
        {
            var verifier = new Ed25519Signer();

            verifier.Init(
                false,
                new Ed25519PublicKeyParameters(publicKeyBytes, 0));

            verifier.BlockUpdate(
                message,
                0,
                message.Length);

            return verifier.VerifySignature(signatureBytes);
        }
        finally
        {
            CryptographicOperations.ZeroMemory(publicKeyBytes);
            CryptographicOperations.ZeroMemory(message);
            CryptographicOperations.ZeroMemory(signatureBytes);
        }
    }
}




